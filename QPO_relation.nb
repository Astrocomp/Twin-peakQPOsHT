Cell[CellGroupData[{

Cell["Cusp Torus (CT) model", "Subtitle",
 CellFrame->{{0, 0}, {0, 0}},
 CellChangeTimes->{{3.9911095512351723`*^9, 3.991109587789692*^9}, 
   3.9911242309902687`*^9, {3.9911243148871975`*^9, 3.991124317829056*^9}, {
   3.9911955148843155`*^9, 3.991195517186043*^9}, {3.9911957895146008`*^9, 
   3.991195789678808*^9}, 3.991205851187563*^9},
 FontColor->GrayLevel[0.5],
 Background->None,ExpressionUUID->"40d97ef2-6488-bb49-9e61-13ec8753580d"],

Cell["\<\
The full expressions for the radial precession frequency of a cusp torus are \
too lengthy to be included here; therefore, we use the approximate relations \
derived by Matuszkov\[AAcute] et al. (2024), while the complete \
implementation can be found in the accompanying Wolfram Mathematica notebook \
available at https://github.com/Astrocomp/HTtori_oscillations.\
\>", "Text",
 CellFrame->{{0, 0}, {0, 0}},
 CellFrameColor->None,
 CellChangeTimes->{{3.9908624001665974`*^9, 3.990862490433111*^9}, {
   3.990862806740366*^9, 3.990862812525984*^9}, {3.991195947431801*^9, 
   3.9911959644418793`*^9}, 3.99119961135717*^9, {3.991199672371353*^9, 
   3.9911996727295284`*^9}, {3.991199917433338*^9, 3.991200005422615*^9}, {
   3.9912001155587807`*^9, 3.9912001205351906`*^9}, {3.991200244442074*^9, 
   3.9912002570706425`*^9}, {3.9912002903294983`*^9, 
   3.9912003405285816`*^9}, {3.9912005618712215`*^9, 3.991200678461231*^9}, {
   3.991201914824566*^9, 3.991201921029007*^9}, {3.99120406649782*^9, 
   3.991204082382303*^9}, 3.991204141719364*^9, {3.9912049759780197`*^9, 
   3.9912049809073544`*^9}, 3.9912050110002785`*^9},
 FontColor->GrayLevel[0.5],
 Background->None,ExpressionUUID->"446bf049-2448-624a-abe4-4c1515e11c64"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Approximate twin-peak QPO relations", "Subtitle",
 CellFrame->{{0, 0}, {0, 0}},
 CellFrameColor->None,
 CellChangeTimes->{{3.9908563934228497`*^9, 3.9908563974893703`*^9}, {
  3.991120491840084*^9, 3.99112052078203*^9}, {3.991199619409811*^9, 
  3.9911996247104855`*^9}, {3.991205028924431*^9, 3.9912050290700474`*^9}},
 FontColor->GrayLevel[0.5],
 Background->None,ExpressionUUID->"d22dc352-442e-6746-a5d5-90e5d4c4e5bb"],

Cell["Equation (30), (36)  and (38) of Matuszkov\[AAcute] et al. (2024)", \
"Text",
 CellFrame->{{0, 0}, {0, 0}},
 CellFrameColor->None,
 CellChangeTimes->{{3.9908624001665974`*^9, 3.990862490433111*^9}, {
  3.990862806740366*^9, 3.990862812525984*^9}},
 FontColor->GrayLevel[0.5],
 Background->None,ExpressionUUID->"76a8525e-9a83-014d-950b-00dbbb96f884"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"\[Nu]L", "=", 
    RowBox[{"\[Nu]U", 
     RowBox[{"(", 
      RowBox[{"1", "-", 
       RowBox[{"B", " ", 
        RowBox[{"Sqrt", "[", 
         RowBox[{"1", "-", 
          RowBox[{"6", 
           RowBox[{"V0", "^", 
            RowBox[{"(", 
             RowBox[{"2", "/", "3"}], ")"}]}]}], "+", 
          RowBox[{"8", "j", " ", "V0"}], "+", 
          RowBox[{"57", 
           RowBox[{"j", "^", "2"}], 
           RowBox[{"V0", "^", 
            RowBox[{"(", 
             RowBox[{"7", "/", "3"}], ")"}]}]}], "-", 
          RowBox[{"3", "q", " ", 
           RowBox[{"V0", "^", 
            RowBox[{"(", 
             RowBox[{"4", "/", "3"}], ")"}]}], 
           RowBox[{"(", 
            RowBox[{"1", "+", 
             RowBox[{"19", "V0"}]}], ")"}]}]}], "]"}]}]}], ")"}]}]}], ";", 
   " ", 
   RowBox[{"V0", "=", 
    RowBox[{
     RowBox[{"\[Nu]U", "/", "\[Nu]0"}], "/", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"6", "^", "1.5"}], "-", 
       RowBox[{"j", " ", 
        RowBox[{"\[Nu]U", "/", "\[Nu]0"}]}], "-", 
       RowBox[{
        RowBox[{"1", "/", "2"}], 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"j", "^", "2"}], "-", "q"}], ")"}], 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"\[Nu]U", "/", "\[Nu]0"}], ")"}], "^", "2"}]}]}], ")"}]}]}],
    ";", " ", 
   RowBox[{"\[Nu]0", "=", 
    RowBox[{
     RowBox[{"1", "/", 
      RowBox[{"(", 
       RowBox[{"2", "Pi"}], ")"}]}], 
     RowBox[{
      RowBox[{
       RowBox[{"c", "^", "3"}], "/", 
       RowBox[{"(", 
        RowBox[{"G", " ", "M", " ", "Msun"}], ")"}]}], "/", 
      RowBox[{"6", "^", 
       RowBox[{"(", 
        RowBox[{"3", "/", "2"}], ")"}]}]}]}]}], ";", " ", 
   RowBox[{"B", "=", 
    RowBox[{"1", "-", 
     RowBox[{"0.2", 
      RowBox[{"(", 
       RowBox[{"1", "+", "j"}], ")"}], 
      RowBox[{"bb", "^", "2"}]}]}]}], ";"}], "\[IndentingNewLine]", 
  RowBox[{"(*", " ", 
   RowBox[{
    RowBox[{"bb", " ", "=", " ", 
     RowBox[{
      RowBox[{"0", " ", "--"}], " ", "RP", " ", "model"}]}], ",", "   ", 
    RowBox[{"bb", " ", "=", " ", 
     RowBox[{
      RowBox[{"1", " ", "--"}], " ", "CT", " ", "model"}]}]}], " ", "*)"}], 
  "\[IndentingNewLine]"}]], "Input",
 CellFrame->{{0, 0}, {0, 0}},
 CellFrameColor->None,
 CellChangeTimes->{{3.990861924341263*^9, 3.9908620884255524`*^9}, {
  3.990862177482441*^9, 3.990862284808674*^9}, {3.990862333408617*^9, 
