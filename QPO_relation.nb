Cell[CellGroupData[{
Cell["Twin-peak QPO relations in the Hartle-Thorne metric", "Title",
 CellFrame->{{0, 0}, {0, 0}},
 CellFrameColor->None,
 CellChangeTimes->{
  3.797072826769539*^9, {3.892191181995819*^9, 3.892191183594328*^9}, {
   3.892191952612283*^9, 3.89219195616879*^9}, {3.892194941934148*^9, 
   3.892194949350976*^9}, {3.990855152035223*^9, 3.990855161957958*^9}, {
   3.990856309611204*^9, 3.990856320577011*^9}, {3.9911219784019833`*^9, 
   3.9911219816309834`*^9}},
 FontColor->GrayLevel[0.5],
 Background->None,ExpressionUUID->"bdb0c715-3388-a84b-8413-f3709aa60d76"],

Cell[TextData[{
 "This Mathematica notebook serves as supplementary material to the paper by \
T\[ODoubleDot]r\[ODoubleDot]k et al. (submitted to MNRAS) and contains \
analytical relations used for modelling twin-peak quasi-periodic oscillations \
(QPOs) in the framework of the Hartle\[Dash]Thorne spacetime.\n\nThe notebook \
provides the metric coefficients of the Hartle\[Dash]Thorne solution, \
expressions for the Keplerian orbital frequency, radial and vertical \
epicyclic frequencies, and calculations of the innermost stable circular \
orbit (ISCO), following the formulation presented by Abramowicz et al. \
(2003). For modelling twin-peak QPOs, we use the approximate relations \
derived by Matuszkov\[AAcute] et al. (2024).\n\n",
 StyleBox["References",
  FontSize->18],
 "\nHartle J. B. & Thorne K. S., 1968, APJ, 153, 807\nAbramowicz M . A ., \
Almergren G . J . E ., Klu\:017aniak W ., & Thampan A . V ., 2003, gr qc, gr \
- qc/0312070\nMatuszkov\[AAcute] M., T\[ODoubleDot]r\[ODoubleDot]k G., \
Klimovi\[CHacek]ov\[AAcute] K., Hor\[AAcute]k J., Straub O., \
\[CapitalSHacek]r\[AAcute]mkov\[AAcute] E., Lan\[CHacek]ov\[AAcute] D., \
Urbanec M., Urbancov\[AAcute] G., Karas V., 2024, A&A, 691, A168\n"
}], "Text",
 CellFrame->{{0, 0}, {0, 0}},
 CellFrameColor->None,
 CellChangeTimes->{{3.8947015261049843`*^9, 3.894701535305841*^9}, {
   3.894701744792749*^9, 3.894701746185957*^9}, {3.8947017797346153`*^9, 
